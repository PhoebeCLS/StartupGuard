<ui:FluentWindow x:Class="StartupGuard.TrayHost.InterceptionDiffDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="StartupGuard"
        Height="510" Width="760"
        MinHeight="410" MinWidth="620"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="StartupGuard" ShowMinimize="True" ShowMaximize="False" ShowClose="True" />

        <!-- 头部提示与快捷全选栏 -->
        <Border Grid.Row="1" Margin="20,8,20,10" Background="Transparent" MouseLeftButtonDown="HeaderDragMove_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TxtHeaderTitle" Text="检测到新增启动或扩展项" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCopyAiPrompt" Content="复制 AI 提示词" Icon="{ui:SymbolIcon Copy20}" Appearance="Secondary" Padding="10,4" FontSize="12" Margin="0,0,8,0" ToolTip="组合当前拦截项关键信息为 AI 提示词并复制到剪贴板" Click="BtnCopyAiPrompt_Click" />
                    <ui:Button x:Name="BtnSelectAllToggle" Content="全选 / 取消全选" Appearance="Transparent" Padding="8,4" FontSize="12" Click="BtnSelectAllToggle_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中间卡片列表区 -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="8" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <Border Grid.Column="1" Width="50" Height="44" CornerRadius="7" Background="{Binding CategoryTintBrush}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding CategoryName}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding CategoryIcon}" FontSize="18" Foreground="{Binding CategoryAccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CategoryShortLabel}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding CategoryAccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 目标信息与菜单位置标记 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="250" />

                                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#1A0078D4" Visibility="{Binding HasMenuScene, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding MenuSceneText}" FontSize="10.5" Foreground="#0078D4" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                            </Border>

                                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#1A107C41">
                                                <TextBlock Text="{Binding Publisher}" FontSize="10.5" Foreground="#107C41" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding TargetPath}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ComboBox ItemsSource="{Binding AvailableActions}" 
                                                  SelectedItem="{Binding SelectedAction, Mode=TwoWay}" 
                                                  DisplayMemberPath="Title"
                                                  MinWidth="135"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"/>

                                        <ui:Button Content="{Binding DetailButtonText}" Appearance="Transparent" Padding="6,4" FontSize="11" Click="BtnItemDetail_Click" Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>

                                <!-- 实用详情面板：命令行与注册表位置可点击跳转，右键菜单支持深入分析与更多操作 -->
                                <Border Visibility="{Binding DetailsVisibility}" 
                                        Margin="0,10,0,0" Padding="12" CornerRadius="6" 
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                        BorderThickness="1">
                                    <StackPanel>
                                        <!-- 右键菜单作用位置 (仅右键菜单项展示) -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding HasMenuScene, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="菜单位置:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MenuSceneText}" FontSize="11.5" Padding="6,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 安装 / 创建来源进程 -->
                                        <Grid Margin="0,0,0,8" Visibility="{Binding HasCreatorProcess, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="创建进程:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding CreatorProcessText, Mode=OneWay}" IsReadOnly="True"
                                                        FontSize="11.5" Padding="8,4" VerticalAlignment="Center"
                                                        BorderThickness="0" Background="Transparent"/>
                                        </Grid>

                                        <!-- 命令行 / 文件路径 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="命令行 / 路径:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding CommandLineText, Mode=OneWay}" IsReadOnly="True"
                                                        FontSize="11.5" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        BorderThickness="0" Background="Transparent"/>
                                            <ui:Button Grid.Column="2" Content="打开" Appearance="Secondary" Padding="10,4" FontSize="11" Icon="{ui:SymbolIcon FolderOpen20}" Click="BtnOpenTargetFile_Click" Tag="{Binding}"/>
                                        </Grid>

                                        <!-- 注册表 / 存储位置 -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="注册表 / 存储:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ui:TextBox Grid.Column="1" Text="{Binding DisplayLocationKey, Mode=OneWay}" IsReadOnly="True"
                                                        FontSize="11.5" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                                        BorderThickness="0" Background="Transparent"/>
                                            <ui:Button Grid.Column="2" Content="定位" Appearance="Secondary" Padding="10,4" FontSize="11" Icon="{ui:SymbolIcon Search20}" Click="BtnOpenRegistry_Click" Tag="{Binding}"/>
                                        </Grid>

                                        <!-- 精简去重后的快捷辅助操作栏 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:Button Content="深入分析" Appearance="Secondary" Padding="10,4" FontSize="11.5" Margin="0,0,8,0"
                                                       Visibility="{Binding IsContextMenuItem, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Click="BtnAnalyzeContextMenu_Click" Tag="{Binding}"/>
                                            <ui:Button Content="文件属性" Appearance="Secondary" Padding="10,4" FontSize="11.5" Margin="0,0,8,0"
                                                       Click="MenuFileProperties_Click" Tag="{Binding}"/>
                                            <ui:Button Content="联网搜索" Appearance="Secondary" Padding="10,4" FontSize="11.5" Margin="0,0,8,0"
                                                       Click="MenuSearchWeb_Click" Tag="{Binding}"/>
                                            <ui:Button Content="CLSID 位置" Appearance="Secondary" Padding="10,4" FontSize="11.5"
                                                       Visibility="{Binding HasClsid, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Click="MenuOpenClsid_Click" Tag="{Binding}"/>
                                            <ui:Button Content="AI 提示词" Appearance="Secondary" Padding="10,4" FontSize="11.5" Margin="8,0,0,0"
                                                       Click="MenuCopyItemAiPrompt_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部 WinUI 3 操作栏 -->
        <Border Grid.Row="3" Padding="20,10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkPermanentBlock" 
                              Content="创建规则" 
                              IsChecked="False" 
                              VerticalAlignment="Center" 
                              FontSize="12.5"
                              FontWeight="SemiBold"
                              Checked="ChkPermanentBlock_CheckedChanged"
                              Unchecked="ChkPermanentBlock_CheckedChanged"
                              ToolTip="勾选后按所选动作保存规则，后续自动执行；未勾选仅本次生效。"/>

                    <ComboBox x:Name="CmbRuleMode" 
                              Margin="12,0,0,0" 
                              SelectedIndex="0" 
                              FontSize="11.5" 
                              MinWidth="130"
                              Visibility="{Binding ElementName=ChkPermanentBlock, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBoxItem Content="永久拦截"/>
                        <ComboBoxItem Content="仅此版本"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnAllowAll" Content="允许全部" Appearance="Secondary" Margin="0,0,10,0" Padding="16,6" Click="BtnAllowAll_Click" />
                    <ui:Button x:Name="BtnBlockSelected" Content="阻止所选" Appearance="Danger" Padding="18,6" Click="BtnBlockSelected_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 深入分析结果浮层 -->
        <Grid x:Name="DialogDeepAnalysisHost" Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="Collapsed">
            <Border Width="580" MaxHeight="440" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtAnalyzeTitle" Text="深入分析结果" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,8,0">
                                <TextBlock Text="Shell Extension" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <Border Padding="6,2" CornerRadius="4" Background="#1A0078D4">
                                <TextBlock x:Name="TxtAnalyzeProbeBadge" Text="完整菜单探测" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="处理程序文件路径:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAnalyzeDllPath" Text="-" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="注册表路径:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAnalyzeRegPath" Text="-" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="处理程序 CLSID:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAnalyzeClsid" Text="-" FontSize="12" Foreground="#0078D4" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="已解析菜单项" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="TxtAnalyzeNote" Text="菜单文字与图标为运行时探测结果；部分自绘或回调扩展可能无法显示全部子项。" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Border CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ListView x:Name="ListAnalyzeMenuItems" MaxHeight="150" Padding="4"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{Binding IndentMargin}" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="› " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Verb}" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding HasVerb, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="关闭" Appearance="Primary" Padding="18,6" Click="BtnAnalyzeClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
