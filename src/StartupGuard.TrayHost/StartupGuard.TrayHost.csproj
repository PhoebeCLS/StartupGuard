<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>StartupGuard.TrayHost</RootNamespace>
    <AssemblyName>StartupGuard.TrayHost</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\StartupGuard.App\Themes\FluentBackdropHelper.cs" Link="Themes\FluentBackdropHelper.cs" />
    <Compile Include="..\StartupGuard.App\Themes\FluentComboBoxBehavior.cs" Link="Themes\FluentComboBoxBehavior.cs" />
    <Compile Include="..\StartupGuard.App\Themes\FluentScrollBarBehavior.cs" Link="Themes\FluentScrollBarBehavior.cs" />
    <Page Include="..\StartupGuard.App\Themes\FluentSharedStyles.xaml" Link="Themes\FluentSharedStyles.xaml" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\StartupGuard.Core\StartupGuard.Core.csproj" />
  </ItemGroup>
</Project>
