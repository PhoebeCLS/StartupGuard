                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,8,0" Click="TglWinXItem_Click" Tag="{Binding}"/>
                                                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" ToolTip="重命名" Padding="6,4" Height="28" Margin="0,0,4,0" Click="BtnWinXRenameItem_Click" Tag="{Binding}"/>
                                                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Appearance="Secondary" ToolTip="上移" Padding="6,4" Height="28" Margin="0,0,4,0" IsEnabled="{Binding CanMoveUp}" Click="BtnWinXMoveUp_Click" Tag="{Binding}"/>
                                                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Appearance="Secondary" ToolTip="下移" Padding="6,4" Height="28" Margin="0,0,4,0" IsEnabled="{Binding CanMoveDown}" Click="BtnWinXMoveDown_Click" Tag="{Binding}"/>
                                                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary" ToolTip="删除" Padding="6,4" Height="28" Margin="0,0,6,0" Click="BtnWinXDeleteItem_Click" Tag="{Binding}"/>
                                                                    <ui:Button Content="···" Appearance="Secondary" FontSize="12" Padding="8,2" Height="28" Click="BtnMoreActions_Click" Tag="{Binding}">
                                                                        <ui:Button.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="打开目标文件位置" Click="BtnWinXOpenTarget_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="打开快捷方式所在文件夹" Click="BtnWinXOpenLnkFolder_Click" Tag="{Binding}"/>
                                                                            </ContextMenu>
                                                                        </ui:Button.ContextMenu>
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="OverlayContextMenuLoading" Grid.Row="2" Visibility="Collapsed"
                            Background="Transparent" CornerRadius="8" Panel.ZIndex="10">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" CornerRadius="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Opacity="0.96"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="正在刷新右键菜单..." FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- ================= 页面 3: 待审核中心 ================= -->
                <Grid x:Name="PageAuditCenter" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="待审核中心" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TxtPendingSummary" Text="共有 0 项待审核" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnRefreshAudit" Content="刷新" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0" Click="BtnRefreshAudit_Click"/>
                            <ui:Button x:Name="BtnAuditSelectAll" Content="全选" Appearance="Secondary" Icon="{ui:SymbolIcon CheckboxChecked24}" Margin="0,0,8,0" Click="BtnAuditSelectAll_Click"/>
                            <ui:Button x:Name="BtnBatchApproveSelected" Content="批量放行" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnBatchApproveSelected_Click"/>
                            <ui:Button x:Name="BtnBatchBlockSelected" Content="批量阻止" Appearance="Secondary" Icon="{ui:SymbolIcon Dismiss24}" Visibility="Collapsed" Click="BtnBatchBlockSelected_Click"/>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="ListViewAuditCenter" 
                              Grid.Row="1" 
                              BorderThickness="0" 
                              Background="Transparent" 
                              Padding="0,0,10,0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,14" CornerRadius="8" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding RealIconSource}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasRealIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="#FFB900" Visibility="{Binding HasRealIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border Margin="8,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1AFFB900">
                                                    <TextBlock Text="{Binding AuditSource}" FontSize="11" Foreground="#FFB900"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1A0078D4" Visibility="{Binding HasMenuScene, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding MenuSceneText}" FontSize="11" Foreground="#0078D4"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CommandOrPath}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Reason}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="··· 更多 ▾" Appearance="Secondary" FontSize="12" Padding="10,4" ToolTip="处置操作与详情" Click="BtnMoreActions_Click" Tag="{Binding}">
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="放行（启用/自动）" Click="MenuAuditApproveItem_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="设为延迟启动" Click="MenuAuditSetDelayedItem_Click" Tag="{Binding}" Visibility="{Binding IsServiceCategory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <MenuItem Header="设为手动" Click="MenuAuditSetManualItem_Click" Tag="{Binding}" Visibility="{Binding IsServiceOrDriverCategory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <MenuItem Header="阻止并禁止/屏蔽" Click="MenuAuditBlockItem_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="删除此项" Click="MenuAuditDeleteItem_Click" Tag="{Binding}" Visibility="{Binding CanDeleteAuditItem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <MenuItem Header="加入永久阻止规则" Click="MenuAuditPersistRule_Click" Tag="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="按应用查找" Click="MenuAuditManageApp_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="深入分析" Click="BtnAuditAnalyzeItem_Click" Tag="{Binding}" Visibility="{Binding IsContextMenu, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <MenuItem Header="查看详情与路径" Click="BtnAuditDetailItem_Click" Tag="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="打开文件位置" Click="MenuAuditOpenFile_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="打开注册表位置" Click="MenuAuditOpenReg_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="文件属性" Click="MenuAuditProperties_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="联网搜索" Click="MenuAuditSearchWeb_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="打开 CLSID 位置" Click="MenuAuditOpenClsid_Click" Tag="{Binding}" Visibility="{Binding HasClsid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ================= 页面 4: 拦截回滚日志与规则库 (整合两大视图) ================= -->
                <Grid x:Name="PageLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="日志与规则" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="系统启动项与右键菜单拦截历史与安全规则" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnOpenCreateRuleDialog" Icon="{ui:SymbolIcon Add24}" Content="新建规则" Appearance="Primary" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnOpenCreateRuleDialog_Click"/>
                            <ui:Button x:Name="BtnClearAllLogs" Icon="{ui:SymbolIcon Delete24}" Content="清空日志" Appearance="Secondary" Margin="0,0,8,0" Click="BtnClearAllLogs_Click"/>
                            <ui:Button x:Name="BtnRefreshLogs" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="刷新" Appearance="Primary" Click="BtnRefreshLogs_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 顶部选项卡与 WizTree 风格筛选触发按钮 -->
                    <Border Grid.Row="1" Margin="0,0,0,10" Padding="4,2" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="FilterRulesShowLogs" Style="{StaticResource FluentPivotTabStyle}" IsChecked="True" Checked="FilterRules_Checked" Tag="ShowLogs">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0" FontSize="16"/>
                                        <TextBlock Text="拦截日志"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="FilterRulesShowRules" Style="{StaticResource FluentPivotTabStyle}" Checked="FilterRules_Checked" Tag="ShowRules">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,8,0" FontSize="16"/>
                                        <TextBlock Text="防护规则"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                <StackPanel x:Name="PanelRulesGroupSwitch" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <RadioButton x:Name="RbRulesGroupByCategory" Content="按类型" Style="{StaticResource FluentPivotTabStyle}" GroupName="RulesGroupMode" IsChecked="True" Checked="RulesGroupMode_Checked" Tag="ByCategory"/>
                                    <RadioButton x:Name="RbRulesGroupByApp" Content="按应用" Style="{StaticResource FluentPivotTabStyle}" GroupName="RulesGroupMode" Checked="RulesGroupMode_Checked" Tag="ByApp"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLogsFilterSummary" Text="" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button x:Name="BtnToggleLogsFilter" Content="筛选" Icon="{ui:SymbolIcon Filter24}" Appearance="Secondary" Padding="12,5" Click="BtnToggleLogsFilter_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 可折叠 WizTree 风格叠加筛选抽屉 -->
                    <Border x:Name="PanelLogsFilterDrawer" Grid.Row="2" Visibility="Collapsed"
                            Margin="0,0,0,12" Padding="14,12" CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtSearchLogsOrRules" Grid.Column="0" Margin="0,0,8,0"
                                            PlaceholderText="搜索名称、路径或位置关键字..."
                                            Icon="{ui:SymbolIcon Search24}"
                                            TextChanged="LogsFilterInput_Changed"/>
                                <ui:Button x:Name="BtnResetLogsFilter" Grid.Column="1" Content="重置" Appearance="Secondary"
                                           Padding="14,6" Click="BtnResetLogsFilter_Click"/>
                            </Grid>

                            <WrapPanel x:Name="PanelLogStatusFilters" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="事件状态:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,4"/>
                                <CheckBox x:Name="ChkLogStatusBlocked" Content="已拦截" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,0,12,4" Click="LogsFilterInput_Changed"/>
                                <CheckBox x:Name="ChkLogStatusPending" Content="待审核" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,0,12,4" Click="LogsFilterInput_Changed"/>
                                <CheckBox x:Name="ChkLogStatusAllowed" Content="已放行" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,0,12,4" Click="LogsFilterInput_Changed"/>
                                <CheckBox x:Name="ChkLogStatusFailed" Content="执行异常" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,0,12,4" Click="LogsFilterInput_Changed"/>
                            </WrapPanel>

                            <StackPanel x:Name="PanelCategoryFilters">
                                <TextBlock Text="项目分类:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                                <Border Margin="0,0,0,5" Padding="8,4" CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" x:Name="ChkLogsGroupStartup" Content="自启项"
                                                  IsThreeState="True" IsChecked="False" FontSize="12"
                                                  MinWidth="0" Padding="4,1,0,1" Margin="2,0,0,0"
                                                  ToolTip="全选或取消自启分类"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Click="ChkLogsGroupStartup_Click"/>
                                        <Border Grid.Column="1" Width="1" Margin="8,2"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkCatStartupItem" Content="自启程序" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,12,1" Click="LogsFilterInput_Changed"/>
                                            <CheckBox x:Name="ChkCatWin32Service" Content="系统服务" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,12,1" Click="LogsFilterInput_Changed"/>
                                            <CheckBox x:Name="ChkCatKernelDriver" Content="内核驱动" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,12,1" Click="LogsFilterInput_Changed"/>
                                            <CheckBox x:Name="ChkCatScheduledTask" Content="计划任务" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,12,1" Click="LogsFilterInput_Changed"/>
                                            <CheckBox x:Name="ChkCatWindowsPolicy" Content="系统策略" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,0,1" Click="LogsFilterInput_Changed"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Border Padding="8,4" CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" x:Name="ChkLogsGroupContextMenu" Content="右键菜单"
                                                  IsThreeState="True" IsChecked="False" FontSize="12"
                                                  MinWidth="0" Padding="4,1,0,1" Margin="2,0,0,0"
                                                  ToolTip="全选或取消右键分类"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Click="ChkLogsGroupContextMenu_Click"/>
                                        <Border Grid.Column="1" Width="1" Margin="8,2"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ChkCatClassicMenu" Content="经典右键" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,12,1" Click="LogsFilterInput_Changed"/>
                                            <CheckBox x:Name="ChkCatModernMenu" Content="Win11 右键" FontSize="12" MinWidth="0" Padding="4,1,0,1" Margin="0,1,0,1" Click="LogsFilterInput_Changed"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 日志按天分组折叠视图 (今日默认展开，非今日默认折叠) -->
                    <ScrollViewer x:Name="LogsDayScrollViewer" Grid.Row="3" Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Visible">
                        <ItemsControl x:Name="ListViewLogs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10" Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding HeaderTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Padding="8,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="8"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            ToolTip="点击跳转到对应项进行管理"
                                                            MouseLeftButtonUp="AuditLogCard_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Converter={StaticResource ProgramIconConverter}}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding Converter={StaticResource HasIconVisibilityConverter}}"/>
                                                                    <ui:SymbolIcon Symbol="{Binding CategoryIcon}" FontSize="18" Foreground="#8764B8" Visibility="{Binding Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Padding="6,2" CornerRadius="4" Background="{Binding ActionBadgeBackground}">
                                                                        <TextBlock Text="{Binding DisplayActionText}" FontSize="12" Foreground="{Binding ActionBadgeForeground}" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <TextBlock Text="{Binding TargetProgram}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding LocationKey}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DiagnosticText}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <!-- 右侧: 时间与 [手动处置 / 恢复状态] 按钮 -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding EventTime, StringFormat='HH:mm:ss'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                                                <ui:Button Content="{Binding LogActionButtonText}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUndo24}" Click="BtnUndoLog_Click" Tag="{Binding}" Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 防护规则库分组折叠视图 (默认按类型分组，支持切换按应用查看；规则详情默认折叠) -->
                    <ScrollViewer x:Name="RulesScrollViewer" Grid.Row="3" Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="ListViewRules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10" Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,10,0">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Source="{Binding AppIconSource}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasAppIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="16" Foreground="#8764B8" Visibility="{Binding HasAppIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HeaderTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="8,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="8"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Tag="{Binding}"
                                                            ToolTip="点击跳转到对应项进行管理"
                                                            MouseLeftButtonUp="AuditLogCard_MouseLeftButtonUp">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Image Source="{Binding Rule, Converter={StaticResource ProgramIconConverter}}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding Rule, Converter={StaticResource HasIconVisibilityConverter}}"/>
                                                                        <ui:SymbolIcon Symbol="{Binding Rule.CategoryIcon}" FontSize="18" Foreground="#8764B8" Visibility="{Binding Rule, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ShortTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                                        <Border Margin="8,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                            <TextBlock Text="{Binding Rule.CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        </Border>
                                                                        <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{Binding Rule.ActionBadgeBackground}">
                                                                            <TextBlock Text="{Binding Rule.ActionTypeText}" FontSize="11" Foreground="{Binding Rule.ActionBadgeForeground}"/>
                                                                        </Border>
                                                                        <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                            <TextBlock Text="{Binding Rule.RuleModeText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Rule.TargetBinaryOrCommand}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:Button Content="{Binding DetailsToggleLabel}" Appearance="Transparent" FontSize="12" Padding="8,4" Margin="0,0,6,0" ToolTip="展开或收起规则详细特征" Click="BtnToggleRuleItemDetails_Click" Tag="{Binding}" />
                                                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="编辑" Appearance="Secondary" Margin="0,0,6,0" Click="BtnEditRule_Click" Tag="{Binding}" />
                                                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="删除此条规则" Click="BtnDeleteRule_Click" Tag="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 规则详情（默认折叠，点击展开） -->
                                                            <Border Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Margin="52,8,0,0" Padding="12,10" CornerRadius="6"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="命令 / 路径" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <ui:TextBox Grid.Column="1" Text="{Binding Rule.TargetBinaryOrCommand, Mode=OneWay}" IsReadOnly="True"
                                                                                    FontSize="12" Padding="8,5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <ui:Button Grid.Column="2" Content="打开" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen20}"
                                                                                   FontSize="12" Padding="10,5" Click="BtnRuleOpenFile_Click" Tag="{Binding}"/>
                                                                    </Grid>

                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="注册表位置" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <ui:TextBox Grid.Column="1" Text="{Binding Rule.DisplayLocationKey, Mode=OneWay}" IsReadOnly="True"
                                                                                    FontSize="12" Padding="8,5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                        <ui:Button Grid.Column="2" Content="定位" Appearance="Secondary" Icon="{ui:SymbolIcon Search20}"
                                                                                   FontSize="12" Padding="10,5" Click="BtnRuleOpenLocation_Click" Tag="{Binding}"/>
                                                                    </Grid>

                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="68"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="签名 / 哈希" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <TextBox Grid.Column="1" Text="{Binding Rule.PublisherDisplay, Mode=OneWay, StringFormat='发布者: {0}'}" IsReadOnly="True"
                                                                                 BorderThickness="0" Background="Transparent" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                 Padding="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                        <TextBox Grid.Column="2" Text="{Binding Rule.Md5Display, Mode=OneWay, StringFormat='MD5: {0}'}" IsReadOnly="True"
                                                                                 BorderThickness="0" Background="Transparent" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                 FontFamily="Consolas, Cascadia Mono, monospace" Padding="0" VerticalAlignment="Center"/>
                                                                    </Grid>

                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Rule.LastUpdatedLocal, StringFormat='最后更新: {0:yyyy-MM-dd HH:mm}'}"
                                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <ui:Button Content="查看详情" Appearance="Secondary" Icon="{ui:SymbolIcon Info24}" FontSize="12" Padding="9,4" Margin="0,0,6,0" Click="BtnRuleViewDetail_Click" Tag="{Binding}"/>
                                                                            <ui:Button Content="复制 AI 提示词" Appearance="Secondary" Icon="{ui:SymbolIcon Copy20}" FontSize="12" Padding="9,4" Margin="0,0,6,0" Click="BtnRuleCopyAiPrompt_Click" Tag="{Binding}"/>
                                                                            <ui:Button Content="联网搜索" Appearance="Secondary" Icon="{ui:SymbolIcon Search20}" FontSize="12" Padding="9,4" Click="BtnRuleSearchWeb_Click" Tag="{Binding}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 页面 5: 系统设置与关于 (严格效仿 Microsoft Store 图六风格) ================= -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <StackPanel Margin="0,0,4,24">
                            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,16"/>

                            <!-- 设置卡片 1: 外观主题 -->
                            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Color24" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="外观主题" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CmbTheme" HorizontalAlignment="Stretch" SelectionChanged="CmbTheme_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                                        <ComboBoxItem Content="浅色" Tag="Light"/>
                                        <ComboBoxItem Content="深色" Tag="Dark"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 设置卡片 2: 右键菜单拦截策略 -->
                            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Shield24" FontSize="20" Margin="0,0,14,0" Foreground="#009688" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="右键菜单处理方式" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="新注册右键菜单项的默认处理方式" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="CmbContextMenuStrategy" HorizontalAlignment="Stretch" SelectionChanged="CmbContextMenuStrategy_SelectionChanged">
                                        <ComboBoxItem Content="先拦截后审核" Tag="InterceptAndAudit"/>
                                        <ComboBoxItem Content="弹窗即时审核" Tag="PromptImmediate"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- 设置卡片 3: 全屏游戏免打扰 -->
                            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Games24" FontSize="20" Margin="0,0,14,0" Foreground="#FFB900" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="全屏游戏免打扰" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="全屏运行游戏时暂存弹窗，退出后统一提示" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="2" x:Name="ToggleAutoGameMode" Content="启用" IsChecked="True" Click="ToggleAutoGameMode_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 设置卡片 4: 通知中心（官方原生 CardExpander，默认收起） -->
                            <ui:CardExpander x:Name="CardExpanderNotifications"
                                             Margin="0,0,0,14"
                                             Padding="16,14"
                                             ContentPadding="16,12"
                                             IsExpanded="False">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon Symbol="Alert24" FontSize="20" Foreground="#0078D4"/>
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="通知中心" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="统一管理规则命中与右键菜单拦截的桌面系统通知提醒" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="1" x:Name="BtnSystemNotifyWarning"
                                                   Content="⚠ 系统通知未开启（点击开启）"
                                                   Appearance="Transparent"
                                                   Foreground="#C42B1C"
                                                   FontSize="12"
                                                   Padding="8,4"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"
                                                   Click="BtnSystemNotifyWarning_Click"
                                                   ToolTip="Windows 系统通知当前处于关闭状态，可能导致拦截提醒无法弹出。点击跳转到系统通知设置。"/>
                                    </Grid>
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="18" Margin="4,0,14,0" Foreground="#0078D4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="命中规则拦截通知" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="自动命中持久化拦截规则并执行处置时弹出系统通知" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="2" x:Name="ToggleRuleHitNotification" IsChecked="True" Click="ToggleNotificationSetting_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="36,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="AppsListDetail24" FontSize="18" Margin="4,0,14,0" Foreground="#8764B8" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="右键菜单静默拦截通知" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtCtxNotifyHint" Text="先拦截后审核模式下屏蔽新右键菜单时弹出系统通知（弹窗审核模式自动禁用）" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="2" x:Name="ToggleContextMenuNotification" IsChecked="True" Click="ToggleNotificationSetting_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- 设置卡片 5: 清理与维护中心（官方原生 CardExpander，默认展开） -->
                            <ui:CardExpander x:Name="CardExpanderCleanup"
                                             Margin="0,0,0,14"
                                             Padding="16,14"
                                             ContentPadding="16,12"
                                             IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon Symbol="Broom24" FontSize="20" Foreground="#8764B8"/>
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="清理与维护中心" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="集中配置日志自动裁剪、单版本规则定时校验与数据缓存立即清理" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel>

                                            <!-- 5.1 历史日志自动清理 -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="自动清理历史日志" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="开启后按设定保留天数或最大条数上限自动裁剪历史事件记录" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1" x:Name="TglLogAutoPrune" IsChecked="True" Click="TglLogAutoPrune_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                                    <TextBlock Text="保留天数:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <ui:NumberBox x:Name="NumLogRetentionDays" Width="135" Minimum="1" Maximum="3650" SmallChange="1" LargeChange="10"
                                                                  MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" Value="30"
                                                                  Margin="0,0,6,0" ValueChanged="NumLogRetention_ValueChanged"/>
                                                    <TextBlock Text="天" VerticalAlignment="Center" Margin="0,0,22,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                    <TextBlock Text="最大条数:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <ui:NumberBox x:Name="NumLogMaxCount" Width="150" Minimum="0" Maximum="100000" SmallChange="100" LargeChange="500"
                                                                  MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" Value="1000"
                                                                  Margin="0,0,6,0" ValueChanged="NumLogRetention_ValueChanged"/>
                                                    <TextBlock Text="条 (0 = 不限制)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </WrapPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,12"/>

                                            <!-- 5.2 单版本规则定时校验 -->
                                            <Grid Margin="0,0,0,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="单版本规则定时校验" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="定期核对单版本规则对应的程序文件哈希，升级更新后自动失效清理" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1" x:Name="TglMd5Validation" IsChecked="True" Click="TglMd5Validation_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                                    <TextBlock Text="检查间隔:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <ui:NumberBox x:Name="NumMd5ValidationDays" Width="125" Minimum="1" Maximum="360" SmallChange="1" LargeChange="7"
                                                                  MaxDecimalPlaces="0" SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" Value="3"
                                                                  Margin="0,0,6,0" ValueChanged="NumMd5ValidationDays_ValueChanged"/>
                                                    <TextBlock Text="天 (1–360)" VerticalAlignment="Center" Margin="0,0,22,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                                    <CheckBox x:Name="ChkMd5ValidationIdleOnly" Content="仅在电脑空闲时检查" IsChecked="True" MinWidth="0" VerticalAlignment="Center" Click="ChkMd5ValidationIdleOnly_Click" FontSize="13"/>
                                                </WrapPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,12"/>

                                            <!-- 5.3 立即清理与缓存回收 -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="立即清理日志与缓存" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="按勾选范围立即清空全部历史拦截日志、移除失效规则、清理运行缓存并压缩数据库" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1" x:Name="BtnUnifiedCleanup" Content="立即清理" Appearance="Primary" Icon="{ui:SymbolIcon Broom24}" Click="BtnUnifiedCleanup_Click" VerticalAlignment="Center"/>
                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                                    <CheckBox x:Name="ChkCleanAuditLogs" Content="清空全部历史日志" IsChecked="True" MinWidth="0" Padding="4,1,0,1" Margin="0,0,16,4" FontSize="12"/>
                                                    <CheckBox x:Name="ChkCleanInvalidRules" Content="单版本失效规则" IsChecked="True" MinWidth="0" Padding="4,1,0,1" Margin="0,0,16,4" FontSize="12"/>
                                                    <CheckBox x:Name="ChkCleanLocalCaches" Content="本地运行日志与临时缓存" IsChecked="True" MinWidth="0" Padding="4,1,0,1" Margin="0,0,16,4" FontSize="12"/>
                                                </WrapPanel>
                                            </Grid>
                                </StackPanel>
                            </ui:CardExpander>

                            <!-- 设置卡片 6.5: 弹窗默认处置动作（官方原生 CardExpander） -->
                            <ui:CardExpander x:Name="CardExpanderDefaultActions"
                                             Margin="0,0,0,14"
                                             Padding="16,14"
                                             ContentPadding="16,12"
                                             IsExpanded="False">
                                <ui:CardExpander.Icon>
                                    <ui:SymbolIcon Symbol="FlashCheckmark24" FontSize="20" Foreground="#0078D4"/>
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="弹窗默认处置动作" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="设置拦截审核弹窗中各类型项目默认选中的处置操作" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="启动程序" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <ComboBox Grid.Column="1" x:Name="CmbDefaultActionStartup" SelectionChanged="CmbDefaultPopupAction_SelectionChanged" Tag="StartupItem">
