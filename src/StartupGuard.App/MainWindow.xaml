                    </StackPanel>

                    <ListView x:Name="ListViewClassicMenu" 
                              Grid.Row="2" 
                              BorderThickness="0" 
                              Background="Transparent" 
                              Padding="0,0,10,0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" CornerRadius="8" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1.8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding RealIconSource}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasRealIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <ui:SymbolIcon Symbol="DocumentTable24" FontSize="20" Foreground="#009688" Visibility="{Binding HasRealIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                <Border Margin="8,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1A009688">
                                                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#009688"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CommandOrPath}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding LocationKey}" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Note, StringFormat='备注: {0}'}" FontSize="11" Margin="0,2,0,0" Foreground="#0078D4" TextTrimming="CharacterEllipsis" Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- 右侧操作栏 (深入分析 / 开关 / 更多操作下拉) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="深入分析" Appearance="Secondary" FontSize="11" Padding="8,2" Height="28" Margin="0,0,8,0"
                                                       Visibility="{Binding CanDeepAnalyze, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Click="BtnAnalyzeItem_Click" Tag="{Binding}"/>

                                            <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,10,0" Click="TglStartupItem_Click" Tag="{Binding}" />

                                            <ui:Button Content="··· 更多 ▾" Appearance="Secondary" FontSize="12" Padding="8,2" Height="28"
                                                       Click="BtnMoreActions_Click" Tag="{Binding}">
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="按应用查找" Click="MenuManageApp_Click" Tag="{Binding}"/>
                                                        <MenuItem Header="删除此项" Click="MenuDelete_Click" Tag="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="详细信息">
                                                            <MenuItem Header="编辑备注" Click="MenuEditNote_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="联网搜索" Click="MenuSearchWeb_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="文件属性" Click="MenuProperties_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="打开文件位置" Click="MenuOpenFileLocation_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="打开注册表位置" Click="MenuOpenRegLocation_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="导出注册表项" Click="MenuExportReg_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="打开 CLSID 位置" Click="MenuOpenClsidLocation_Click" Tag="{Binding}"/>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 按应用查看右键菜单分组视图 -->
                    <ScrollViewer x:Name="ContextMenuByAppScrollViewer" Grid.Row="2" Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="ListViewContextMenuByApp">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10" Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
