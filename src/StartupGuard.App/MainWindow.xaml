                                                <TextBlock Text="ContextMenuMgr 致谢项目：WPF Fluent UI 现代化界面样式参考" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,1,0,4"/>
