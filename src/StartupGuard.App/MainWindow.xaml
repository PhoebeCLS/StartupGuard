                                                <TextBlock Text=".NET SQLite 数据访问驱动 (底层 SQLite 引擎为 Public Domain)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,1,0,8"/>
