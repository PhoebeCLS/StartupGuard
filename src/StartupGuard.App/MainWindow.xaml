                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="Win11 Context Menu Mgr (MIT)" Margin="0,0,0,1" Tag="https://github.com/branhill/windows-11-context-menu-manager" Click="BtnStoreLink_Click"/>
                                                <TextBlock Text="ContextMenuMgr 致谢项目：Windows 11 PackagedCom 现代右键管理参考" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,1,0,4"/>
                                            </StackPanel>

