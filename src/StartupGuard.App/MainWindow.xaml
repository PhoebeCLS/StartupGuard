                                    <ComboBoxItem Content="复制 (Copy)" Tag="1"/>
                                    <ComboBoxItem Content="移动 (Move)" Tag="2"/>
                                    <ComboBoxItem Content="创建快捷方式 (Link)" Tag="4"/>
                                </ComboBox>
