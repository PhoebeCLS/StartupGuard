                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="检查最新发布版本" Tag="https://github.com/PhoebeCLS/StartupGuard/releases" Click="BtnStoreLink_Click"/>
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="GitHub 开源仓库" Tag="https://github.com/PhoebeCLS/StartupGuard" Click="BtnStoreLink_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,14"/>

