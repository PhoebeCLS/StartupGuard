                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10" Padding="0">
                                            <Expander.Header>
                                                <Grid Margin="2,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Folder24" FontSize="16" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GroupName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <Border Margin="8,0,0,0" Padding="7,1.5" CornerRadius="9" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,8,0" Click="TglWinXGroup_Click" Tag="{Binding}"/>
                                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" ToolTip="重命名分组" Padding="6,4" Margin="0,0,6,0" Click="BtnWinXRenameGroup_Click" Tag="{Binding}"/>
                                                        <ui:Button Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Secondary" ToolTip="恢复默认组项" Padding="6,4" Margin="0,0,6,0"
                                                                   Visibility="{Binding CanRestoreDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Click="BtnWinXRestoreGroup_Click" Tag="{Binding}"/>
                                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary" ToolTip="删除分组" Padding="6,4" Click="BtnWinXDeleteGroup_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
