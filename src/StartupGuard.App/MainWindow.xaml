                                <StackPanel>
                                    <TextBlock Text="当前分析对象" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock x:Name="TxtAnalyzedTargetPath" Text="" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="ListAnalysisMatches">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding BreadcrumbText}" FontSize="12" Foreground="#0078D4"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="1" Content="跳转到管理" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowRight24}" Click="BtnJumpAnalysisMatch_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Win+X 分组管理视图 (参考 ContextMenuManager / ContextMenuMgr 分组结构与排序重命名操作) -->
                    <ScrollViewer x:Name="WinXGroupedScrollViewer" Grid.Row="2" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Padding="14,10" CornerRadius="8" Margin="0,0,0,10"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Win+X 快捷菜单分组管理" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtWinXStatusHint" Text="按 Group 分组展示，可开关、重命名、上移/下移排序、恢复默认或删除；改动后需重启资源管理器生效" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnWinXCreateGroup" Content="+ 新建分组" Appearance="Secondary" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="BtnWinXCreateGroup_Click"/>
                                        <ui:Button x:Name="BtnWinXRestartExplorer" Content="重启资源管理器" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Secondary" Padding="10,5" FontSize="12" Click="BtnWinXRestartExplorer_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="ListViewWinXGroups">
