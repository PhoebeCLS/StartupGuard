                        <Border x:Name="PanelGuidBlockedBar" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
