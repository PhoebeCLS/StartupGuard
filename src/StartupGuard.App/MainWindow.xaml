                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="帮助与说明文档" Tag="https://github.com/PhoebeCLS/StartupGuard" Click="BtnStoreLink_Click"/>
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="软件使用与协议说明 (GPL-3.0)" Tag="https://github.com/PhoebeCLS/StartupGuard/blob/main/LICENSE" Click="BtnStoreLink_Click"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="问题反馈与建议" Tag="https://github.com/PhoebeCLS/StartupGuard/issues" Click="BtnStoreLink_Click"/>
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="第三方致谢声明" Tag="https://github.com/PhoebeCLS/StartupGuard/blob/main/THIRD-PARTY-NOTICES.md" Click="BtnStoreLink_Click"/>
