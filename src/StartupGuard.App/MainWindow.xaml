                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="WPF-UI (MIT)" Margin="0,0,0,1" Tag="https://github.com/lepoco/wpfui" Click="BtnStoreLink_Click"/>
                                                <TextBlock Text="现代化 WinUI 3 Fluent 控件库与 Mica 背景支持" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,1,0,8"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                                                <Button Style="{StaticResource StoreLinkButtonStyle}" Content="ContextMenuMgr (GPL-3.0)" Margin="0,0,0,1" Tag="https://github.com/PLFJY/ContextMenuMgr" Click="BtnStoreLink_Click"/>
                                                <TextBlock Text="重点致谢：Windows 经典与 Win11 现代外壳菜单架构及先拦截设计参考" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,1,0,8"/>
                                            </StackPanel>

