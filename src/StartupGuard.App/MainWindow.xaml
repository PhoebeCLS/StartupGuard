                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="TxtAppAboutVersion" Text="版本 1.0.0" FontSize="12" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </ui:CardExpander.Header>
                                <StackPanel x:Name="AboutDetailsPanel">

                                        <!-- 链接区域 (效仿 Microsoft Store 无下划线弹性动效按钮) -->
