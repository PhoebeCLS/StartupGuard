                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="8,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding AllItems}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Image Source="{Binding RealIconSource}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasRealIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="18" Foreground="#009688" Visibility="{Binding HasRealIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </Border>
                                                                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#1A009688">
                                                                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#009688"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding CommandOrPath}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding LocationKey}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ui:Button Content="深入分析" Appearance="Secondary" FontSize="11" Padding="8,2" Height="26" Margin="0,0,8,0"
                                                                           Visibility="{Binding CanDeepAnalyze, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                           Click="BtnAnalyzeItem_Click" Tag="{Binding}"/>
                                                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,10,0" Click="TglStartupItem_Click" Tag="{Binding}" />
                                                                <ui:Button Content="··· 更多 ▾" Appearance="Secondary" FontSize="12" Padding="8,2" Height="26"
                                                                           Click="BtnMoreActions_Click" Tag="{Binding}">
                                                                    <ui:Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="删除此项" Click="MenuDelete_Click" Tag="{Binding}"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="详细信息">
                                                                                <MenuItem Header="编辑备注" Click="MenuEditNote_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="联网搜索" Click="MenuSearchWeb_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="文件属性" Click="MenuProperties_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="打开文件位置" Click="MenuOpenFileLocation_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="打开注册表位置" Click="MenuOpenRegLocation_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="导出注册表项" Click="MenuExportReg_Click" Tag="{Binding}"/>
                                                                                <MenuItem Header="打开 CLSID 位置" Click="MenuOpenClsidLocation_Click" Tag="{Binding}"/>
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </ui:Button.ContextMenu>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 菜单分析视图（分析文件 / 分析文件夹与场景跳转卡片） -->
                    <ScrollViewer x:Name="MenuAnalysisPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                                  AllowDrop="True" DragOver="MenuAnalysis_DragOver" Drop="MenuAnalysis_Drop">
                        <StackPanel>
                            <Border Padding="20,18" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="菜单分析" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="分析文件、文件夹或快捷方式，并跳转到匹配的右键菜单场景（支持直接拖拽文件/文件夹到此处）。" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button x:Name="BtnAnalyzeTargetFile" Content="分析文件" Appearance="Secondary" Icon="{ui:SymbolIcon Document24}" Margin="0,0,10,0" Click="BtnAnalyzeTargetFile_Click"/>
                                        <ui:Button x:Name="BtnAnalyzeTargetFolder" Content="分析文件夹" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnAnalyzeTargetFolder_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

