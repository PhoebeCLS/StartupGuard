<ui:FluentWindow x:Class="StartupGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:StartupGuard.App.Converters"
        mc:Ignorable="d"
        Title="StartupGuard" 
        Icon="Assets/app.ico"
        Height="650" Width="1020" MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{DynamicResource AppFont}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        MouseDown="MainWindow_MouseDown">

    <Window.Resources>
        <conv:ProgramIconConverter x:Key="ProgramIconConverter"/>
        <conv:HasIconVisibilityConverter x:Key="HasIconVisibilityConverter"/>
        <conv:InverseHasIconVisibilityConverter x:Key="InverseHasIconVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 现代化 WinUI 3 Navigation View 侧边栏导航项样式 -->
        <Style x:Key="WinUi3NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True" />

                            <Rectangle x:Name="ActiveIndicator"
                                       Width="3"
                                       Height="16"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       Visibility="Collapsed" />

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化 WinUI 3 Navigation View 二级子导航项样式 (用于右键菜单二级场景分类) -->
        <Style x:Key="WinUi3NavSubItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="24,0,10,0" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" />

                            <Rectangle x:Name="ActiveIndicator"
                                       Width="3"
                                       Height="14"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Visibility="Collapsed" />

                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化 WinUI 3 Fluent Pivot 紧凑顶栏选项卡样式 (短横线指示器，整齐小巧单行容纳不翻页) -->
        <Style x:Key="FluentPivotTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" />

                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />

                            <Rectangle x:Name="ActiveIndicator"
                                       Height="2.5"
                                       Width="18"
                                       RadiusX="1.25"
                                       RadiusY="1.25"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,1"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Microsoft Store 规范的无下划线弹性跳跃链接按钮样式 -->
        <Style x:Key="StoreLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部 WinUI 3 标题栏 (三栏居中布局，搜索框严格居中，右侧预留动态筛选按钮) -->
        <Grid x:Name="TitleBarContainer" Grid.Row="0" Height="46"
              PreviewMouseLeftButtonDown="TitleBarContainer_PreviewMouseLeftButtonDown">
            <ui:TitleBar x:Name="AppTitleBar"
                         Height="46"
                         Title=""
                         Padding="0"
                         VerticalAlignment="Stretch"
                         ShowHelp="False"
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True"
                         WndProcInvoked="AppTitleBar_WndProcInvoked" />
            <Grid Panel.ZIndex="10" Height="46" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,12,0">
                    <ui:Button x:Name="BtnNavBack"
                               Width="34"
                               Height="28"
                               Padding="0"
                               Margin="0,0,6,0"
                               Background="Transparent"
                               Appearance="Transparent"
                               BorderThickness="0"
                               CornerRadius="4"
                               IsHitTestVisible="True"
                               Visibility="Collapsed"
                               Opacity="0"
                               ToolTip="返回上一页 (Alt+Left)"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               PreviewMouseLeftButtonDown="BtnNavBack_PreviewMouseLeftButtonDown"
                               PreviewMouseLeftButtonUp="BtnNavBack_PreviewMouseLeftButtonUp"
                               MouseLeave="BtnNavBack_MouseLeave"
                               Click="BtnNavBack_Click">
                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" RenderTransformOrigin="0.85,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleNavBack" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="TranslateNavBack" X="0" />
                                </TransformGroup>
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </ui:Button>
                    <TextBlock x:Name="TxtTitleBarBrand"
                               Text="StartupGuard"
                               FontSize="12"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <ui:TextBox x:Name="TxtGlobalSearch"
                            Grid.Column="1"
                            Width="380"
                            MinHeight="34"
                            Height="34"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0"
                            Padding="10,5,8,5"
                            PlaceholderText="搜索自启项、服务、驱动或右键菜单..."
                            Icon="{ui:SymbolIcon Search24}"
                            ClearButtonEnabled="True"
                            FontSize="13"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            TextChanged="TxtGlobalSearch_TextChanged"
                            PreviewMouseLeftButtonDown="TxtGlobalSearch_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="TxtGlobalSearch_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="TxtGlobalSearch_PreviewMouseLeftButtonUp"
                            PreviewKeyDown="TxtGlobalSearch_PreviewKeyDown"/>
                <ui:Button x:Name="BtnGlobalSearchFilterToggle"
                           Grid.Column="2"
                           Width="34"
                           Height="34"
                           Padding="0"
                           Margin="8,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Filter20}"
                           ToolTip="筛选分类"
                           Visibility="Collapsed"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Click="BtnGlobalSearchFilterToggle_Click"/>
            </Grid>
        </Grid>

        <!-- 主内容分区 Grid: 左侧导航栏 (4大类+设置) + 右侧多页面内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="190" MaxWidth="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧原生 WinUI 3 风格通透 Mica 导航区（与标题栏、内容区统一背景色） -->
            <Border Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 应用 Logo 与品牌标识 -->
                    <StackPanel Grid.Row="0" Margin="16,14,16,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#0078D4">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="StartupGuard" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="自启与右键菜单管理" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 统一无边框的四大类主导航项 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,0">
                        <StackPanel>
                            <!-- 1. 自启管理 -->
                            <RadioButton x:Name="NavStartupManager" Style="{StaticResource WinUi3NavRadioButtonStyle}" GroupName="MainNavGroup" IsChecked="True" Checked="Nav_Checked" Tag="PageStartupManager">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Rocket24" Margin="2,0,12,0" FontSize="17" Foreground="#0078D4"/>
                                    <TextBlock Text="自启管理" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. 右键菜单管理 (整行无方框纯原生 Chevron，支持点击行内展开) -->
                            <RadioButton x:Name="NavContextMenu" Style="{StaticResource WinUi3NavRadioButtonStyle}" GroupName="MainNavGroup" Checked="Nav_Checked" Tag="PageContextMenu" PreviewMouseDown="NavContextMenu_PreviewMouseDown" Margin="6,2">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="DocumentTable24" Margin="2,0,12,0" FontSize="17" Foreground="#009688"/>
                                        <TextBlock Text="右键菜单管理" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="1" x:Name="IconContextMenuChevron" Symbol="ChevronDown12" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform x:Name="RotateContextMenuChevron" Angle="0"/>
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </RadioButton>

                            <!-- 右键菜单二级子菜单（采用 WPF-UI 原生 Expander 展开/收起动画） -->
                            <Expander x:Name="ContextMenuSubExpander"
                                      IsExpanded="False"
                                      BorderThickness="0"
                                      BorderBrush="Transparent"
                                      Background="Transparent"
                                      Padding="0"
                                      Margin="8,0,0,4"
                                      Loaded="ContextMenuSubExpander_Loaded"
                                      Expanded="ContextMenuSubExpander_ExpandedCollapsed"
                                      Collapsed="ContextMenuSubExpander_ExpandedCollapsed">
                                <StackPanel x:Name="ContextMenuSubListPanel">
                                <RadioButton x:Name="SubNavWin11Modern" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Win11Modern">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="13" Foreground="#0078D4" Margin="0,0,6,0"/>
                                            <TextBlock Text="Win11 现代菜单" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="新版" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="SubNavClassicFile" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_File" Content="文件" IsChecked="True"/>
                                <RadioButton x:Name="SubNavClassicAllObj" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_AllObjects" Content="所有对象"/>
                                <RadioButton x:Name="SubNavClassicFolder" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_Folder" Content="文件夹"/>
                                <RadioButton x:Name="SubNavClassicDirectory" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_Directory" Content="目录"/>
                                <RadioButton x:Name="SubNavClassicDirBg" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_DirBackground" Content="目录背景"/>
                                <RadioButton x:Name="SubNavClassicDesktopBg" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_DesktopBackground" Content="桌面背景"/>
                                <RadioButton x:Name="SubNavClassicDrive" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_Drive" Content="磁盘分区"/>
                                <RadioButton x:Name="SubNavClassicLibrary" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_Library" Content="库"/>
                                <RadioButton x:Name="SubNavClassicComputer" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_Computer" Content="此电脑"/>
                                <RadioButton x:Name="SubNavClassicRecycleBin" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_RecycleBin" Content="回收站"/>
                                <RadioButton x:Name="SubNavContextByApp" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="ByApp" Content="按应用查看"/>
                                <RadioButton x:Name="SubNavFileTypes" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="FileTypes" Content="文件类型"/>
                                <RadioButton x:Name="SubNavMenuAnalysis" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="MenuAnalysis" Content="菜单分析"/>
                                <RadioButton x:Name="SubNavClassicSendTo" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_SendTo" Content="发送到"/>
                                <RadioButton x:Name="SubNavClassicWinX" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_WinX" Content="Win+X"/>
                                <RadioButton x:Name="SubNavClassicOpenWith" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_OpenWith" Content="打开方式"/>
                                <RadioButton x:Name="SubNavClassicDragDrop" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_DragDrop" Content="右键拖拽"/>
                                <RadioButton x:Name="SubNavClassicCommandStore" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_CommandStore" Content="公共引用"/>
                                <RadioButton x:Name="SubNavClassicGuidBlocked" Style="{StaticResource WinUi3NavSubItemStyle}" GroupName="ContextMenuSubNavGroup" Checked="SubNavContextMenu_Checked" Tag="Scene_GuidBlocked" Content="GUID 锁"/>
                                </StackPanel>
                            </Expander>

                            <!-- 3. 待审核中心 (带徽章计数) -->
                            <RadioButton x:Name="NavAuditCenter" Style="{StaticResource WinUi3NavRadioButtonStyle}" GroupName="MainNavGroup" Checked="Nav_Checked" Tag="PageAuditCenter">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Clock24" Margin="2,0,12,0" FontSize="17" Foreground="#FFB900"/>
                                        <TextBlock Text="待审核" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="BadgePendingCount" Background="#FFB900" CornerRadius="10" Padding="7,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtPendingCount" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <!-- 4. 日志与规则 (整合历史事件与规则库) -->
                            <RadioButton x:Name="NavLogs" Style="{StaticResource WinUi3NavRadioButtonStyle}" GroupName="MainNavGroup" Checked="Nav_Checked" Tag="PageLogs">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="History24" Margin="2,0,12,0" FontSize="17" Foreground="#8764B8"/>
                                    <TextBlock Text="日志与规则" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部固定停靠: 设置与关于 -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,12">
                        <Rectangle Height="1" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="12,0,12,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource WinUi3NavRadioButtonStyle}" GroupName="MainNavGroup" Checked="Nav_Checked" Tag="PageSettings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Settings24" Margin="2,0,12,0" FontSize="17" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="设置与关于" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧主内容展示区域 -->
            <Grid Grid.Column="1" Margin="20,16,20,16">
                <!-- ================= 页面 1: 自启管理 ================= -->
                <Grid x:Name="PageStartupManager" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题与搜索刷新 -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自启管理" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="管理开机启动项、系统服务、内核驱动与计划任务" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtSearchStartup" Width="175" PlaceholderText="搜索程序、路径或发布者..." Margin="0,0,8,0" TextChanged="TxtSearchStartup_TextChanged" />
                            <ui:Button x:Name="BtnRefreshStartup" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="刷新" Appearance="Primary" Click="BtnRefreshStartup_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 顶部紧凑自适应 Pivot 标签栏与隐藏系统项开关 (窄屏自动换行) -->
                    <Border Grid.Row="1" Margin="0,0,0,12" Padding="4,2" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="FilterAll" Style="{StaticResource FluentPivotTabStyle}" IsChecked="True" Checked="Filter_Checked" Tag="All">
                                    <TextBlock Text="全部"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterRun" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="StartupItem">
                                    <TextBlock Text="自启程序"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterService" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="Win32Service">
                                    <TextBlock Text="Win32服务"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterDriver" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="KernelDriver">
                                    <TextBlock Text="内核驱动"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterTask" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="ScheduledTask">
                                    <TextBlock Text="计划任务"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterPolicy" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="WindowsPolicy">
                                    <TextBlock Text="系统策略"/>
                                </RadioButton>
                                <RadioButton x:Name="FilterByApp" Style="{StaticResource FluentPivotTabStyle}" Checked="Filter_Checked" Tag="ByApp">
                                    <TextBlock Text="按应用查看"/>
                                </RadioButton>
                            </WrapPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="TglHideMicrosoft" Content="隐藏系统项" IsChecked="True" Click="TglHideMicrosoft_Click" Margin="6,2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 自启列表 (支持真实程序高清图标提取与SymbolIcon兜底) -->
                    <ListView x:Name="ListViewStartup" 
                              Grid.Row="2" 
                              BorderThickness="0" 
                              Background="Transparent" 
                              Padding="0,0,10,0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,0,0,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,12" CornerRadius="8" 
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1.8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 图标呈现区: 优先展示真实应用提取图标，兜底显示类别矢量图标 -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding RealIconSource}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasRealIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <ui:SymbolIcon Symbol="{Binding CategoryIcon}" FontSize="22" Foreground="#0078D4" Visibility="{Binding HasRealIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                
                                                <Border Margin="8,0,0,0" Padding="5,1.5" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>

                                                <Border Margin="6,0,0,0" Padding="5,1.5" CornerRadius="4" Background="#1A107C41">
                                                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#107C41"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding CommandOrPath}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding StatusSummary}" FontSize="11" Foreground="#0078D4" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding LocationKey}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,12,0" Click="TglStartupItem_Click" Tag="{Binding}" Visibility="{Binding IsBinaryStateCategory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ComboBox Width="106" Margin="0,0,12,0" FontSize="12" Padding="8,4"
                                                      Visibility="{Binding IsMultiStateCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      ItemsSource="{Binding AvailableStateOptions}"
                                                      SelectedItem="{Binding SelectedStateOption, Mode=OneWay}"
                                                      DisplayMemberPath="Title"
                                                      Tag="{Binding}"
                                                      SelectionChanged="CmbStartupItemState_SelectionChanged"/>
                                            <ui:Button Icon="{ui:SymbolIcon Info24}" Appearance="Transparent" ToolTip="查看详情与跳转位置" Click="BtnOpenLocation_Click" Tag="{Binding}" Margin="0,0,4,0" />
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="删除此项" Click="BtnDeleteItem_Click" Tag="{Binding}" Visibility="{Binding CanDeleteItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 按应用查看分组视图 (聚合同一应用的驱动、服务、自启项与右键菜单) -->
                    <ScrollViewer x:Name="StartupByAppScrollViewer" Grid.Row="2" Padding="0,0,8,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="ListViewStartupByApp">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10" Padding="0">
                                        <Expander.Header>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0,0,10,0">
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Source="{Binding AppIconSource}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasAppIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <ui:SymbolIcon Symbol="Apps24" FontSize="16" Foreground="#0078D4" Visibility="{Binding HasAppIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppTitle}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding CategorySummary}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Padding="8,2" CornerRadius="10" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding CategorySections}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding CategoryTitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="4,0,0,4"/>
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,6" Padding="14,10" CornerRadius="8"
                                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <Image Source="{Binding RealIconSource}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasRealIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                    <ui:SymbolIcon Symbol="{Binding CategoryIcon}" FontSize="18" Foreground="#0078D4" Visibility="{Binding HasRealIcon, Converter={StaticResource InverseHasIconVisibilityConverter}}"/>
                                                                                </Grid>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                                    </Border>
                                                                                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="4" Background="#1A107C41">
                                                                                        <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#107C41"/>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding CommandOrPath}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                                <TextBlock Text="{Binding LocationKey}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="0,0,10,0" Click="TglStartupItem_Click" Tag="{Binding}" Visibility="{Binding IsBinaryStateCategory, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                <ComboBox Width="106" Margin="0,0,10,0" FontSize="12" Padding="8,4"
                                                                                          Visibility="{Binding IsMultiStateCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                          ItemsSource="{Binding AvailableStateOptions}"
                                                                                          SelectedItem="{Binding SelectedStateOption, Mode=OneWay}"
                                                                                          DisplayMemberPath="Title"
                                                                                          Tag="{Binding}"
                                                                                          SelectionChanged="CmbStartupItemState_SelectionChanged"/>
                                                                                <ui:Button Icon="{ui:SymbolIcon Info24}" Appearance="Transparent" ToolTip="查看详情与跳转位置" Click="BtnOpenLocation_Click" Tag="{Binding}" Margin="0,0,4,0" />
                                                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="删除此项" Click="BtnDeleteItem_Click" Tag="{Binding}" Visibility="{Binding CanDeleteItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 首页首次加载与手动刷新动画 (与主界面一致的透明底 + 居中半透明圆角方框) -->
                    <Border x:Name="OverlayStartupLoading" Grid.Row="2" Visibility="Collapsed"
                            Background="Transparent" CornerRadius="8" Panel.ZIndex="10">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" CornerRadius="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Opacity="0.96"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtStartupLoadingLabel" Text="正在加载系统启动项..." FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- ================= 页面 2: 右键菜单管理 ================= -->
                <Grid x:Name="PageContextMenu" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtContextMenuPageTitle" Text="右键菜单管理" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TxtContextMenuPageSubtitle" Text="管理经典外壳与现代扩展右键菜单" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:TextBox x:Name="TxtSearchClassicMenu" Width="175" PlaceholderText="搜索菜单项、DLL或CLSID..." Margin="0,0,8,0" TextChanged="TxtSearchClassicMenu_TextChanged" />
                            <ui:Button x:Name="BtnRefreshClassicMenu" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="刷新" Appearance="Primary" Click="BtnRefreshClassicMenu_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 场景扩展工具区：文件类型横向标签页 + 打开方式来源检查 + 右键拖拽默认效果 + GUID 锁新增 -->
                    <StackPanel Grid.Row="1">
                        <!-- 文件类型横向标签页（窄屏自动折行排版） -->
                        <StackPanel x:Name="FileTypesHeaderPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <Border Padding="4" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabFileTypeLnk" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="LnkFile" Content="快捷方式" IsChecked="True" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypeUwpLnk" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="UwpLnk" Content="UWP 快捷方式" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypeExe" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="ExeFile" Content="可执行文件" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypeCustomExt" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="CustomExtension" Content="自定义扩展名" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypePerceived" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="PerceivedType" Content="感知类型" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypeDirType" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="DirectoryType" Content="目录类型" Checked="FileTypeTab_Checked"/>
                                    <RadioButton x:Name="TabFileTypeUnknown" Style="{StaticResource FluentPivotTabStyle}" GroupName="FileTypeTabGroup" Tag="UnknownType" Content="未知类型" Checked="FileTypeTab_Checked"/>
                                </WrapPanel>
                            </Border>

                            <!-- 子参数控制条（自定义扩展名 / 感知类型 / 目录类型） -->
                            <Border x:Name="PanelFileTypeParamBar" Visibility="Collapsed" Margin="0,8,0,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <WrapPanel x:Name="PanelCustomExtensionInput" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="扩展名：" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ui:TextBox x:Name="TxtCustomExtension" Width="180" PlaceholderText="例如 .txt 或 .zip" Text=".txt" Margin="0,0,8,0" KeyDown="TxtCustomExtension_KeyDown"/>
                                        <ui:Button x:Name="BtnLoadCustomExtension" Content="加载" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnLoadCustomExtension_Click"/>
                                    </WrapPanel>

                                    <StackPanel x:Name="PanelPerceivedTypeInput" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择感知类型：" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbPerceivedTypeSelector" Width="200" SelectionChanged="CmbPerceivedTypeSelector_SelectionChanged">
                                            <ComboBoxItem Content="文本文件 (text)" Tag="text"/>
                                            <ComboBoxItem Content="文档文件 (document)" Tag="document"/>
                                            <ComboBoxItem Content="图片文件 (image)" Tag="image"/>
                                            <ComboBoxItem Content="视频文件 (video)" Tag="video"/>
                                            <ComboBoxItem Content="音频文件 (audio)" Tag="audio"/>
                                            <ComboBoxItem Content="压缩文件 (compressed)" Tag="compressed"/>
                                            <ComboBoxItem Content="系统文件 (system)" Tag="system"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelDirectoryTypeInput" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择目录类型：" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbDirectoryTypeSelector" Width="200" SelectionChanged="CmbDirectoryTypeSelector_SelectionChanged">
                                            <ComboBoxItem Content="文档文件夹 (Document)" Tag="Document"/>
                                            <ComboBoxItem Content="图片文件夹 (Image)" Tag="Image"/>
                                            <ComboBoxItem Content="视频文件夹 (Video)" Tag="Video"/>
                                            <ComboBoxItem Content="音频文件夹 (Audio)" Tag="Audio"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 打开方式：按文件扩展名检查注册来源（只读） -->
                        <Border x:Name="PanelOpenWithInspector" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="按文件扩展名检查注册来源（只读）" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:TextBox x:Name="TxtOpenWithCheckExt" Width="150" Text=".txt" PlaceholderText="输入如 .txt" Margin="0,0,8,0" KeyDown="TxtOpenWithCheckExt_KeyDown"/>
                                    <ui:Button x:Name="BtnCheckOpenWithSource" Content="检查来源" Appearance="Secondary" Margin="0,0,6,0" Click="BtnCheckOpenWithSource_Click"/>
                                    <ui:Button x:Name="BtnCancelOpenWithCheck" Content="取消" Appearance="Secondary" Click="BtnCancelOpenWithCheck_Click"/>
                                </WrapPanel>
                                <TextBox x:Name="TxtOpenWithCheckResult"
                                         Visibility="Collapsed"
                                         Margin="0,8,0,0"
                                         Padding="10,8"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MaxHeight="135"
                                         FontSize="12"
                                         FontFamily="Consolas, Microsoft YaHei UI"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- 右键拖拽：默认拖放效果 (DefaultDropEffect) -->
                        <Border x:Name="PanelDragDropEffect" Visibility="Collapsed" Margin="0,0,0,12" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="默认拖放效果：" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ComboBox x:Name="CmbDefaultDropEffect" Width="180" Margin="0,0,12,0" SelectionChanged="CmbDefaultDropEffect_SelectionChanged">
